# Port the Express server listens on
PORT=8080

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_URL=http://localhost:3000,https://your-vercel-domain.vercel.app

# Path to the yt-dlp binary. On most hosts (Render/Railway with the provided
# Dockerfile) this is just "yt-dlp" once it's installed on the system.
YTDLP_PATH=yt-dlp

# Path to the ffmpeg binary, used to merge video+audio for formats that
# don't come with audio already attached (see /api/download-merged). Usually
# just "ffmpeg" once it's installed and on PATH.
FFMPEG_PATH=ffmpeg

# Container used when merging video+audio in /api/download-merged. mkv (the
# default) accepts virtually any codec combination without re-encoding;
# forcing mp4 here is faster to try but can produce a file that plays audio
# over a black screen for some sources, since mp4 is picky about muxing
# fragmented/DASH-sourced video without a re-encode. Only change this if you
# specifically need .mp4 output and have tested it against your own sources.
MERGE_CONTAINER=mkv

# How long (seconds) to cache extraction results for the same URL in memory
CACHE_TTL_SECONDS=300

# Max requests per IP per window (basic abuse protection)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Same idea, but for /api/download-merged specifically — merging video+audio
# is far more expensive per request (a real yt-dlp + ffmpeg run), so it gets
# its own, stricter limit.
MERGE_RATE_LIMIT_WINDOW_MS=60000
MERGE_RATE_LIMIT_MAX=6
